AUTH_SECRET=generate-a-long-random-secret
AUTH_OWNER_EMAIL=owner@example.com
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Set to true to record analytics from local development (off by default so dev visits do not pollute real stats)
ANALYTICS_IN_DEV=false

# Optional email alerts (new-message emails and the Monday digest). Leave blank to disable.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
# Required for the weekly digest cron; Vercel sends it as a Bearer token. Any long random string.
CRON_SECRET=
